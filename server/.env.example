PORT=3010
# Production: set NODE_ENV=production and list exact HTTPS frontend origins.
# Native clients without an Origin header remain supported.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
DB_NAME=SakayNE
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
APP_NAME=Sakay
# Public development services; use your own instances for sustained production load.
OSRM_URL=https://routing.openstreetmap.de/routed-car
PHOTON_URL=https://photon.komoot.io
# Optional real public app URL, sent as the provider Referer.
MAP_APP_REFERER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set only when provisioning a new administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=
