{
  "name": "sakay",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "security:env": "node scripts/check-public-env.cjs",
    "security:test": "node --test scripts/security-compat.test.cjs",
    "prestart": "npm run security:env",
    "prebuild:web": "npm run security:env",
    "preandroid": "npm run security:env",
    "preios": "npm run security:env",
    "preweb": "npm run security:env",
    "postinstall": "node scripts/patch-web-compat.cjs",
    "start": "expo start",
    "start:clean": "npm run security:env && expo start --clear --port 8081 --max-workers 1",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.3.6",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^4.1.2",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.3",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-toast-message": "^2.4.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "5.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "lightningcss": "1.30.1",
    "minimatch@>=7.0.0 <11.0.1": "11.0.8",
    "@expo/ngrok": {
      "uuid": "11.1.1"
    },
    "query-string": {
      "decode-uri-component": "0.5.1"
    }
  },
  "private": true
}
