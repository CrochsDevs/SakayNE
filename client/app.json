{
  "expo": {
    "name": "Sakay",
    "slug": "sakayne",
    "owner": "crochsdevs",
    "extra": {
      "eas": {
        "projectId": "269f58c1-45d6-4834-8d10-38f0aa62d10b"
      }
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sakay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crochsdevs.sakayne",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.crochsdevs.sakayne",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/SakayNE.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5EF",
          "dark": {
            "backgroundColor": "#0D222B"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Sakay to share your driver location with passengers during bookings."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
