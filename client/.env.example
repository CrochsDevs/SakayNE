# Physical phone: replace 127.0.0.1 with your computer's LAN IP.
# All EXPO_PUBLIC_ values are public. Database credentials belong only in server/.env.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3010/api
# Optional MapLibre style overrides. No API key is required for OpenFreeMap.
EXPO_PUBLIC_MAP_STYLE_LIGHT_URL=https://tiles.openfreemap.org/styles/positron
EXPO_PUBLIC_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark
# Configure OSRM_URL and PHOTON_URL on the server, not in this public file.
